[Unit]
Description=PiDrive Web UI (Debug/Remote)
# network.target reicht: bindet 0.0.0.0:8080 lokal.
# network-online wartet oft 1–2 Min. (wait-online / WLAN) — unnötig für die WebUI.
After=network.target
Wants=network.target
# KEIN After=pidrive_core — erzeugt Ordering-Cycle beim Shutdown
# Web läuft unabhängig und zeigt "Core offline" wenn nötig
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
UMask=0000
Type=simple
User=PIDRIVE_REAL_USER
Group=PIDRIVE_REAL_USER
SupplementaryGroups=systemd-journal
WorkingDirectory=/home/pi/pidrive/pidrive
ExecStart=/usr/bin/python3 /home/pi/pidrive/pidrive/webui.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
