[Unit]
Description=PiDrive WLAN Recovery (Boot + nach Stromausfall)
# Kein network-online: sonst warten wir auf networkd-wait-online-Timeout (~2 min).
# Script exit 0 sofort, wenn wlan0 schon SSID+IPv4 hat.
After=network.target rfkill-unblock.service
Wants=network.target rfkill-unblock.service

[Service]
Type=oneshot
User=root
# Kein festes sleep — verzögerte Nachversuche macht der Timer (OnBootSec).
ExecStart=/bin/bash /home/pi/pidrive/scripts/wifi-recover.sh
TimeoutStartSec=120
Nice=10
RemainAfterExit=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
