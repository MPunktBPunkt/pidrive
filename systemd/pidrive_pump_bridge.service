[Unit]
Description=PiDrive PUMP Bridge (UART/TCP ↔ esp32.pidrive Live-MP3 + Menü)
After=network.target pidrive_core.service
Wants=network.target
# UART: udev SYSTEMD_WANTS bei ttyACM0. TCP/auto: ohne Port starten (Settings usb_pump_*).
# Condition entfernt — Bridge wählt Transport selbst (auto: UART falls da, sonst TCP).

[Service]
UMask=0000
Type=simple
User=pidrive
Group=dialout
SupplementaryGroups=disk
WorkingDirectory=/home/pidrive
Environment=PYTHONPATH=/home/pidrive/pidrive/pidrive
# Optional override: PUMP_TRANSPORT=tcp PUMP_HOST=192.168.4.1 PUMP_TCP_PORT=9090
# Deploy: esp32.pidrive/tools/pump_bridge.py → /home/pidrive/pump_bridge.py
ExecStart=/usr/bin/python3 -u /home/pidrive/pump_bridge.py --transport auto --interval 0.5 --bitrate 48k
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
