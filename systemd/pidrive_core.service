[Unit]
Description=PiDrive Core - Car Infotainment
# Nicht After=multi-user.target — das verschiebt den Core hinter fast alle anderen
# multi-user-Dienste (u. a. raspotify). network.target + Audio/BT reichen.
After=network.target pipewire.service pipewire-pulse.service wireplumber.service bluetooth.service
Wants=network.target pipewire.service pipewire-pulse.service wireplumber.service bluetooth.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
UMask=0000
Type=simple
User=root
WorkingDirectory=/home/pi/pidrive/pidrive

# v0.9.0: PULSE_SERVER sicherstellen - alle Kindprozesse (mpv, rtl_fm|mpv, welle-cli|mpv)
# nutzen damit den System-PulseAudio-Socket statt User-Session
Environment=PULSE_SERVER=unix:/var/run/pulse/native

ExecStart=/usr/bin/python3 /home/pi/pidrive/pidrive/main_core.py

Restart=on-failure
RestartSec=5
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
