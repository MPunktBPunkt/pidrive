[Unit]
Description=PiDrive Core - Car Infotainment
# network.target reicht (Interface da). network-online wartet oft 2 Min auf
# systemd-networkd-wait-online — unnötig für lokalen Start (BT/PipeWire/Menü).
After=multi-user.target network.target pipewire.service pipewire-pulse.service wireplumber.service bluetooth.service
Wants=network.target pipewire.service pipewire-pulse.service wireplumber.service bluetooth.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
UMask=0000
Type=simple
User=root
WorkingDirectory=/home/pi/pidrive/pidrive

# v0.9.0: PULSE_SERVER sicherstellen - alle Kindprozesse (mpv, rtl_fm|mpv, welle-cli|mpv)
# nutzen damit den System-PulseAudio-Socket statt User-Session
Environment=PULSE_SERVER=unix:/var/run/pulse/native

ExecStartPre=/bin/sleep 1
ExecStart=/usr/bin/python3 /home/pi/pidrive/pidrive/main_core.py

Restart=on-failure
RestartSec=5
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
