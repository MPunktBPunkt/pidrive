[Unit]
Description=PiDrive WLAN Recovery Timer (Nachversuche wenn Boot-Recovery nicht reicht)

[Timer]
# Erster verzögerter Check (Firmware/Router oft erst nach ~45s stabil)
OnBootSec=45s
# Danach alle 5 Min — Script exit 0 sofort, wenn WLAN ok
OnUnitActiveSec=5min
AccuracySec=15s
Persistent=false
Unit=pidrive-wifi-recover.service

[Install]
WantedBy=timers.target
