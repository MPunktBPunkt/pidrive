# PiDrive: USB-Geräte beim Einstecken zuerst NICHT autorisieren (kein Treiber,
# weniger Strom/Enumerations-Last parallel zum Boot).
# Boot-Freigabe ~12s: pidrive-usb-release.service
# Hotplug danach: pidrive-usb-hotplug-release.service (After= Boot-Release)
#
# ESP32 (Espressif)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="303a", ATTR{authorized}="0", TAG+="systemd", ENV{SYSTEMD_WANTS}+="pidrive-usb-hotplug-release.service"
# RTL-SDR (Realtek 2838/2832)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2838", ATTR{authorized}="0", TAG+="systemd", ENV{SYSTEMD_WANTS}+="pidrive-usb-hotplug-release.service"
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2832", ATTR{authorized}="0", TAG+="systemd", ENV{SYSTEMD_WANTS}+="pidrive-usb-hotplug-release.service"
# QinHeng USB-Serial (oft am ESP-Adapter)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="1a86", ATTR{authorized}="0", TAG+="systemd", ENV{SYSTEMD_WANTS}+="pidrive-usb-hotplug-release.service"
